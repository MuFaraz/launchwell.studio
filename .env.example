# Copy to .env.local for local dev. Add the same keys in Vercel → Settings → Environment Variables.

# Forms. Without it, forms fall back to a pre-filled email (mailto) link.
RESEND_API_KEY=
# Optional. Needs a domain verified in Resend. Default: "Launchwell Website <onboarding@resend.dev>"
RESEND_FROM=
# Optional. Where form emails go. Default: studiolaunchwell@gmail.com
CONTACT_TO_EMAIL=

# Analytics. Leave empty to switch off.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# "Book a 15-min call" buttons (final CTA, /white-label-web-development, /about). Hidden when empty.
NEXT_PUBLIC_CALENDLY_URL=

# Optional. Set when you add a custom domain (used for canonical URLs, sitemap, OG).
NEXT_PUBLIC_SITE_URL=https://launchwell-studio.vercel.app
